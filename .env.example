# Optional MySQL database. The app has demo fallback data when omitted.
DATABASE_URL=mysql://user:password@localhost:3306/univerge

# Optional LLM gateway. Without these, UniVerge falls back to retrieval-only answers.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Manus compatibility auth values; not required for local UniVerge login.
VITE_APP_ID=
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
PORT=3000
